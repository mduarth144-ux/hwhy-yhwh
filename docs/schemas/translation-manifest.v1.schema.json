{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yawe.local/schemas/translation-manifest.v1.schema.json",
  "title": "YA-WE Translation Manifest v1",
  "description": "Manifesto individual de uma tradução instalada em data/translations/<translation_id>/manifest.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "sigla",
    "language",
    "edition",
    "revision",
    "origin",
    "copyright",
    "canon",
    "versification",
    "validation",
    "books"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "sigla": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLabel"],
      "properties": {
        "sourceLabel": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string" },
        "importer": { "type": "string" },
        "importedAtUtc": { "type": "string", "format": "date-time" }
      }
    },
    "copyright": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "restrictedDistribution"],
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "holder": { "type": "string" },
        "notice": { "type": "string" },
        "restrictedDistribution": { "type": "boolean" }
      }
    },
    "canon": {
      "type": "string",
      "enum": ["tanakh", "protestant_66", "catholic_73", "lxx", "custom"]
    },
    "versification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "mappedToMasoretic", "validationStatus"],
      "properties": {
        "system": {
          "type": "string",
          "enum": ["masoretic", "christian_standard", "lxx", "vulgate", "mixed"]
        },
        "mappedToMasoretic": { "type": "boolean" },
        "validationStatus": {
          "type": "string",
          "enum": ["validated", "partial", "unvalidated"]
        },
        "notes": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["validated", "partial", "unvalidated", "draft"]
        },
        "validatedAtUtc": { "type": "string", "format": "date-time" },
        "validator": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bookId",
          "title",
          "canonGroup",
          "order",
          "file",
          "chapters",
          "verses",
          "sha256",
          "versificationStatus"
        ],
        "properties": {
          "bookId": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "title": { "type": "string", "minLength": 1 },
          "canonGroup": {
            "type": "string",
            "enum": [
              "torah",
              "prophets",
              "writings",
              "deuterocanonical",
              "new_testament",
              "apocrypha_addition"
            ]
          },
          "order": { "type": "integer", "minimum": 1 },
          "file": { "type": "string", "pattern": "^[a-z0-9_]+\\.json$" },
          "chapters": { "type": "integer", "minimum": 1 },
          "verses": { "type": "integer", "minimum": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "versificationStatus": {
            "type": "string",
            "enum": ["exact_masoretic", "mapped_validated", "native_unmapped", "custom"]
          },
          "lacunaeCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
